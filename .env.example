# Base da API pública do Posto de Enfermagem (sem barra no final).
VITE_API_BASE_URL=https://api.postodeenfermagem.com.br/api/v1

# OBRIGATÓRIO. UUID do tenant cujo catálogo será exibido.
#
# As rotas /public/* dispensam autenticação, mas continuam atrás do middleware
# "tenant" da API — é ele que mantém o isolamento multi-tenant. Sem este header
# a API responde 400 ("Header X-Tenant-ID ausente.").
#
# Para descobrir o UUID, rode no servidor da API:
#   php artisan tinker --execute="echo App\Models\Tenant::pluck('name','id');"
VITE_TENANT_ID=
